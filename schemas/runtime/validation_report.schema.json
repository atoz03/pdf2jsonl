{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breeding-contract.local/schemas/runtime/validation_report.schema.json",
  "title": "pdf2jsonl validation report (<stem>.validation.json)",
  "type": "object",
  "required": [
    "report_format",
    "run_id",
    "contract",
    "profile",
    "input",
    "valid",
    "counts",
    "document",
    "records",
    "rejected",
    "repairs",
    "system_records_skipped"
  ],
  "additionalProperties": false,
  "properties": {
    "report_format": {
      "const": 1
    },
    "run_id": {
      "type": "string"
    },
    "contract": {
      "$ref": "_defs.schema.json#/$defs/contract_identity"
    },
    "profile": {
      "type": "string"
    },
    "input": {
      "type": "object",
      "required": [
        "file_name",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "file_name": {
          "type": "string"
        },
        "sha256": {
          "$ref": "_defs.schema.json#/$defs/sha256"
        }
      }
    },
    "valid": {
      "type": "boolean",
      "description": "Every written record passed validation (rejections are reported, never written)"
    },
    "counts": {
      "type": "object",
      "required": [
        "pages",
        "candidates",
        "records",
        "rejected",
        "by_record_kind",
        "by_review_status",
        "rejected_by_code"
      ],
      "additionalProperties": false,
      "properties": {
        "pages": {
          "type": "integer",
          "minimum": 0
        },
        "candidates": {
          "type": "integer",
          "minimum": 0
        },
        "records": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        },
        "by_record_kind": {
          "$ref": "_defs.schema.json#/$defs/count_map"
        },
        "by_review_status": {
          "$ref": "_defs.schema.json#/$defs/count_map"
        },
        "rejected_by_code": {
          "$ref": "_defs.schema.json#/$defs/count_map"
        }
      }
    },
    "document": {
      "type": "object",
      "required": [
        "values",
        "issues"
      ],
      "additionalProperties": false,
      "properties": {
        "values": {
          "type": "object",
          "description": "Document-level values keyed by dotted field path"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "_defs.schema.json#/$defs/issue"
          }
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "line",
          "record_id",
          "record_kind",
          "candidate_index",
          "warnings"
        ],
        "additionalProperties": false,
        "properties": {
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "record_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "record_kind": {
            "type": "string"
          },
          "candidate_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "warnings": {
            "type": "array",
            "items": {
              "$ref": "_defs.schema.json#/$defs/issue"
            }
          },
          "notes": {
            "type": "object"
          }
        }
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "code",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "stage": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "candidate_index": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "repairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "where",
          "action"
        ],
        "properties": {
          "where": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        }
      }
    },
    "system_records_skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_kind",
          "reason"
        ],
        "properties": {
          "record_kind": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "part": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "argument_structure": {
      "description": "Evidence-chain audit (Toulmin/Flavell elements via catalog argument_role, after TRACE arXiv:2605.29656); structure and connectivity only, not correctness",
      "type": "object",
      "required": [
        "audit_format",
        "statements",
        "coverage",
        "links",
        "flags",
        "records"
      ],
      "properties": {
        "audit_format": {
          "const": 1
        },
        "basis": {
          "type": "string"
        },
        "statements": {
          "type": "integer",
          "minimum": 0
        },
        "coverage": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "own",
              "chain"
            ],
            "properties": {
              "own": {
                "type": "integer",
                "minimum": 0
              },
              "chain": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "links": {
          "type": "object",
          "required": [
            "total",
            "unresolved"
          ]
        },
        "flags": {
          "$ref": "_defs.schema.json#/$defs/count_map"
        },
        "flag_help": {
          "type": "object"
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "record_id",
              "record_kind",
              "elements",
              "chain_elements"
            ]
          }
        }
      }
    },
    "source_parts": {
      "description": "Source completeness (AMB-041): the files supplied, the parts the main text refers to, and the referenced parts that were neither supplied nor found in the supplied pages. Literal detection; it never guesses what a missing part contains",
      "type": "object",
      "required": [
        "provided",
        "referenced",
        "missing",
        "items_not_found",
        "complete"
      ],
      "additionalProperties": false,
      "properties": {
        "provided": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "part",
              "source_part",
              "file_name",
              "sha256",
              "page_count"
            ],
            "additionalProperties": false,
            "properties": {
              "part": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "source_part": {
                "type": "string"
              },
              "file_name": {
                "type": "string"
              },
              "sha256": {
                "$ref": "_defs.schema.json#/$defs/sha256"
              },
              "page_count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "referenced": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "mentions",
              "pages"
            ],
            "additionalProperties": false,
            "properties": {
              "mentions": {
                "type": "integer",
                "minimum": 1
              },
              "pages": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "items_not_found": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "complete": {
          "type": "boolean"
        }
      }
    },
    "workflow_structure": {
      "description": "Research-workflow audit (AMB-039): records as stages, record links with a catalog workflow_edge as edges; structure and connectivity only, not experimental soundness",
      "type": "object",
      "required": [
        "audit_format",
        "stages",
        "edges_by_type",
        "links",
        "flags",
        "hypotheses",
        "steps_ordered",
        "records"
      ],
      "properties": {
        "audit_format": {
          "const": 1
        },
        "basis": {
          "type": "string"
        },
        "stages": {
          "$ref": "_defs.schema.json#/$defs/count_map"
        },
        "edges_by_type": {
          "$ref": "_defs.schema.json#/$defs/count_map"
        },
        "links": {
          "type": "object",
          "required": [
            "total",
            "unresolved"
          ]
        },
        "flags": {
          "$ref": "_defs.schema.json#/$defs/count_map"
        },
        "flag_help": {
          "type": "object"
        },
        "hypotheses": {
          "type": "integer",
          "minimum": 0
        },
        "steps_ordered": {
          "type": "integer",
          "minimum": 0
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "record_id",
              "stage",
              "flags"
            ]
          }
        }
      }
    }
  }
}
