{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breeding-contract.local/schemas/runtime/verification_report.schema.json",
  "title": "bdc verify apply report (<stem>.verification.json)",
  "description": "What an independent verifier judged and which review fields moved (AMB-040). The verifier never changes content: findings, conflict candidates and omission candidates are for reviewers",
  "type": "object",
  "required": [
    "verification_format",
    "run_id",
    "created_at",
    "contract",
    "verifier",
    "independent_of_extractor",
    "counts",
    "findings",
    "conflict_candidates",
    "omission_candidates",
    "unknown_task_ids",
    "input",
    "output"
  ],
  "additionalProperties": false,
  "properties": {
    "verification_format": {
      "const": 1
    },
    "run_id": {
      "type": "string"
    },
    "created_at": {
      "$ref": "_defs.schema.json#/$defs/timestamp"
    },
    "contract": {
      "$ref": "_defs.schema.json#/$defs/contract_identity"
    },
    "verifier": {
      "type": "object",
      "required": [
        "method",
        "model"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "const": "model"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "independent_of_extractor": {
      "description": "false when the verifier is the extraction model (nothing is promoted then); null when the extraction model is unknown because no manifest was given",
      "type": [
        "boolean",
        "null"
      ]
    },
    "counts": {
      "type": "object",
      "required": [
        "records",
        "tasks",
        "by_kind",
        "verdicts",
        "by_verdict",
        "review_status_before",
        "review_status_after",
        "promoted",
        "demoted",
        "confirmed_pending",
        "partially_verified",
        "unchanged",
        "withheld_same_model",
        "unverified",
        "skipped_expert_reviewed",
        "no_tasks"
      ],
      "additionalProperties": false,
      "properties": {
        "records": {
          "type": "integer",
          "minimum": 0
        },
        "tasks": {
          "type": "integer",
          "minimum": 0
        },
        "verdicts": {
          "type": "integer",
          "minimum": 0
        },
        "promoted": {
          "type": "integer",
          "minimum": 0
        },
        "demoted": {
          "type": "integer",
          "minimum": 0
        },
        "confirmed_pending": {
          "type": "integer",
          "minimum": 0
        },
        "partially_verified": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0
        },
        "withheld_same_model": {
          "type": "integer",
          "minimum": 0
        },
        "unverified": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_expert_reviewed": {
          "type": "integer",
          "minimum": 0
        },
        "no_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "by_kind": {
          "$ref": "_defs.schema.json#/$defs/count_map"
        },
        "by_verdict": {
          "$ref": "_defs.schema.json#/$defs/count_map"
        },
        "review_status_before": {
          "$ref": "_defs.schema.json#/$defs/count_map"
        },
        "review_status_after": {
          "$ref": "_defs.schema.json#/$defs/count_map"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "record_id",
          "kind",
          "verdict"
        ],
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string"
          },
          "record_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "record",
              "link"
            ]
          },
          "field": {
            "type": "string"
          },
          "target_record_id": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "not_supported",
              "uncertain"
            ]
          },
          "unsupported_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "conflict_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_ids"
        ],
        "properties": {
          "record_ids": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "omission_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "source_part": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "unknown_task_ids": {
      "type": "array"
    },
    "input": {
      "type": "object",
      "required": [
        "file",
        "sha256",
        "verdicts_file",
        "verdicts_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "sha256": {
          "$ref": "_defs.schema.json#/$defs/sha256"
        },
        "verdicts_file": {
          "type": "string"
        },
        "verdicts_sha256": {
          "$ref": "_defs.schema.json#/$defs/sha256"
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "file",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "sha256": {
          "$ref": "_defs.schema.json#/$defs/sha256"
        }
      }
    }
  }
}
