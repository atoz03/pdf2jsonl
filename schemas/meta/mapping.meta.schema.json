{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:breeding-data-contract:meta:mapping:1",
  "title": "Source-to-contract mapping file format (mapping_format 1)",
  "type": "object",
  "required": ["mapping_format", "id", "source", "target", "entries"],
  "additionalProperties": false,
  "properties": {
    "mapping_format": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "title_zh": {"type": "string"},
    "source": {
      "type": "object",
      "required": ["id", "version", "leaf_source", "file"],
      "additionalProperties": false,
      "properties": {
        "id": {"enum": ["legacy_v1", "omics_v2"]},
        "title_zh": {"type": "string"},
        "version": {"type": "string"},
        "leaf_source": {"enum": ["json_schema", "template_groups"]},
        "file": {"type": "string"}
      }
    },
    "target": {
      "type": "object",
      "required": ["contract", "min_version"],
      "additionalProperties": false,
      "properties": {
        "contract": {"type": "string"},
        "min_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}
      }
    },
    "principles_zh": {"type": "array", "items": {"type": "string"}},
    "routing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "record_kind", "note_zh"],
        "additionalProperties": false,
        "properties": {
          "source": {"type": "string"},
          "record_kind": {"type": "string"},
          "note_zh": {"type": "string"}
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "status"],
        "additionalProperties": false,
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "status": {"enum": ["mapped", "partial", "transformed", "merged", "control", "view_only", "unmapped", "forbidden"],
                     "description": "control = read by the migrator to route, filter or resolve references; no value is copied"},
          "target": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"},
          "targets": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"}},
          "scope": {"enum": ["document", "record"]},
          "note_zh": {"type": "string"},
          "transform": {"enum": ["wrap_array", "single_value_measurement", "relation_claim", "compose",
                                 "resolve_reference", "structure", "split_records"],
                        "description": "kind of transformation for status=transformed (machine-readable)"},
          "issues": {"type": "array", "items": {"type": "string"}}
        },
        "allOf": [
          {"if": {"properties": {"status": {"enum": ["mapped", "partial", "transformed", "merged"]}}},
           "then": {"anyOf": [{"required": ["target"]}, {"required": ["targets"]}]}},
          {"if": {"properties": {"status": {"enum": ["unmapped", "forbidden", "partial", "view_only", "control"]}}},
           "then": {"required": ["note_zh"]}}
        ]
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title_zh", "finding_zh", "resolution_zh"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z]{3}-\\d{3}$"},
          "title_zh": {"type": "string"},
          "finding_zh": {"type": "string"},
          "resolution_zh": {"type": "string"}
        }
      }
    }
  }
}
