{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:breeding-data-contract:meta:field-catalog:1",
  "title": "Field catalog file format (catalog_format 1)",
  "description": "Structure of field_catalog/field_catalog.yaml. Semantic cross-references (types, vocabularies, ambiguities, rule targets) are checked by `bdc check`.",
  "type": "object",
  "required": ["catalog_format", "contract", "codes", "groups", "types", "fields", "rules", "ambiguities"],
  "additionalProperties": false,
  "properties": {
    "catalog_format": {"const": 1},
    "contract": {
      "type": "object",
      "required": ["name", "title_zh", "record_layout", "missing_value_policy"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "title_zh": {"type": "string"},
        "record_layout": {"const": "nested_groups"},
        "missing_value_policy": {"const": "omit"},
        "baseline_zh": {"type": "string"},
        "ambiguities": {"$ref": "#/$defs/amb_refs"}
      }
    },
    "codes": {"type": "object"},
    "groups": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {
        "type": "object",
        "required": ["title_zh", "purpose_zh"],
        "additionalProperties": false,
        "properties": {
          "title_zh": {"type": "string"},
          "purpose_zh": {"type": "string"},
          "consumers_zh": {"type": "string"},
          "serves": {"$ref": "#/$defs/functions"},
          "since": {"$ref": "#/$defs/semver"},
          "origin": {"$ref": "#/$defs/origins"}
        }
      }
    },
    "types": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "json_schema": {"type": "object"},
          "maturity": {"enum": ["verified", "provisional"]},
          "ambiguities": {"$ref": "#/$defs/amb_refs"},
          "item": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "from_fields": {"type": "array", "items": {"type": "string"}},
              "properties": {"type": "object"},
              "required": {"type": "array", "items": {"type": "string"}},
              "any_of_required": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}}
            }
          }
        },
        "oneOf": [{"required": ["json_schema"]}, {"required": ["item"]}]
      }
    },
    "fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/field"}},
    "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
    "ambiguities": {"type": "array", "items": {"$ref": "#/$defs/ambiguity"}}
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "field_path": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"},
    "amb_refs": {"type": "array", "items": {"type": "string", "pattern": "^AMB-\\d{3}$"}, "uniqueItems": true},
    "origins": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["fields_v3", "legacy_v1", "omics_v2", "merged_v2", "repository"]}},
    "functions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["topic2", "topic3", "derivation", "iteration"]}},
    "field": {
      "type": "object",
      "required": ["path", "type", "availability", "required", "definition_zh", "since", "status", "maturity", "origin",
                   "key_role", "serves"],
      "additionalProperties": false,
      "properties": {
        "path": {"$ref": "#/$defs/field_path"},
        "type": {"type": "string"},
        "availability": {"enum": ["D", "N", "I", "G", "F"]},
        "required": {"enum": ["Y", "C", "N"]},
        "definition_zh": {"type": "string", "minLength": 1},
        "data_source_zh": {"type": "string"},
        "downstream_zh": {"type": "string"},
        "since": {"$ref": "#/$defs/semver"},
        "status": {"enum": ["active", "deprecated"]},
        "deprecated_in": {"$ref": "#/$defs/semver"},
        "replaced_by": {"$ref": "#/$defs/field_path"},
        "maturity": {"enum": ["verified", "provisional"]},
        "origin": {"$ref": "#/$defs/origins"},
        "origin_paths": {"type": "array", "items": {"type": "string"}},
        "vocabulary": {"type": "string"},
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["basis"],
          "properties": {
            "minimum": {"type": "number"},
            "maximum": {"type": "number"},
            "pattern": {"type": "string"},
            "basis": {"enum": ["explicit", "definitional", "inferred"]},
            "note_zh": {"type": "string"}
          }
        },
        "ambiguities": {"$ref": "#/$defs/amb_refs"},
        "notes_zh": {"type": "string"},
        "key_role": {"type": "string", "pattern": "^[a-z][a-z_]*$"},
        "serves": {"$ref": "#/$defs/functions"},
        "argument_role": {"enum": ["claim", "data", "warrant", "backing", "qualifier", "rebuttal", "monitoring", "evaluation"]},
        "card": {"enum": ["hypothesis", "experiment_design", "result_analysis"]},
        "source_ref": {"type": "string"}
      }
    },
    "condition": {
      "oneOf": [
        {"type": "object", "required": ["all"], "additionalProperties": false,
         "properties": {"all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}}}},
        {"type": "object", "required": ["any"], "additionalProperties": false,
         "properties": {"any": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}}}},
        {"type": "object", "required": ["present"], "additionalProperties": false,
         "properties": {"present": {"$ref": "#/$defs/field_path"}}},
        {"type": "object", "required": ["any_present"], "additionalProperties": false,
         "properties": {"any_present": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/field_path"}}}},
        {"type": "object", "required": ["field", "equals"], "additionalProperties": false,
         "properties": {"field": {"$ref": "#/$defs/field_path"}, "equals": {"type": ["string", "number", "boolean"]}}},
        {"type": "object", "required": ["field", "in"], "additionalProperties": false,
         "properties": {"field": {"$ref": "#/$defs/field_path"}, "in": {"type": "array", "minItems": 1}}},
        {"type": "object", "required": ["field", "matches"], "additionalProperties": false,
         "properties": {"field": {"$ref": "#/$defs/field_path"}, "matches": {"type": "string", "minLength": 1}}}
      ]
    },
    "rule": {
      "type": "object",
      "required": ["id", "kind", "severity", "basis", "title_zh", "source_zh"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^R\\d{3}$"},
        "kind": {"enum": ["required_when", "require_any_when", "paired", "mutually_exclusive", "lte", "equals_any_field", "forbid_pattern", "grain_matches_kind", "unique_within_dataset", "single_value_per_group", "references_resolve", "offsets_match_text"]},
        "severity": {"enum": ["error", "warning"]},
        "basis": {"enum": ["explicit", "definitional", "inferred"]},
        "title_zh": {"type": "string"},
        "when": {"$ref": "#/$defs/condition"},
        "require": {"type": "array", "items": {"$ref": "#/$defs/field_path"}},
        "require_any": {"type": "array", "items": {"$ref": "#/$defs/field_path"}},
        "fields": {"type": "array", "items": {"type": "string"}},
        "field": {"$ref": "#/$defs/field_path"},
        "candidates": {"type": "array", "items": {"$ref": "#/$defs/field_path"}},
        "group_by": {"$ref": "#/$defs/field_path"},
        "target": {"$ref": "#/$defs/field_path"},
        "pattern": {"type": "string"},
        "spans": {
          "type": "array",
          "description": "offsets_match_text: scalar (mention, start, end) fields checked against the text in `field`; `fields` lists arrays whose items carry mention/start/end",
          "items": {
            "type": "object",
            "required": ["mention", "start", "end"],
            "additionalProperties": false,
            "properties": {"mention": {"$ref": "#/$defs/field_path"}, "start": {"$ref": "#/$defs/field_path"}, "end": {"$ref": "#/$defs/field_path"}}
          }
        },
        "since": {"$ref": "#/$defs/semver"},
        "source_zh": {"type": "string"},
        "ambiguities": {"$ref": "#/$defs/amb_refs"}
      }
    },
    "ambiguity": {
      "type": "object",
      "required": ["id", "status", "title_zh", "finding_zh", "resolution_zh", "since"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^AMB-\\d{3}$"},
        "status": {"enum": ["open", "provisional", "decided", "resolved"]},
        "title_zh": {"type": "string"},
        "finding_zh": {"type": "string"},
        "resolution_zh": {"type": "string"},
        "since": {"$ref": "#/$defs/semver"}
      }
    }
  }
}
