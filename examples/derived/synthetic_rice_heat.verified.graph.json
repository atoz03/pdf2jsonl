{
  "nodes": [
    {
      "id": "doi:10.0000/synthetic.2026.002",
      "kind": "source",
      "label": "A two-gene module at the qHT3 locus protects chloroplasts under heat in a synthetic rice population"
    },
    {
      "id": "rec:rec_d0d87732dff67a2694847f7d0f0fbc61",
      "kind": "record",
      "type": "asset_manifest"
    },
    {
      "id": "rec:rec_c679c3c2c1343cfab188306fefdbb11a",
      "kind": "record",
      "type": "asset_manifest"
    },
    {
      "id": "rec:rec_dc41a78de16f39e31079ea5147e533a6",
      "kind": "record",
      "type": "claim",
      "label": "Heat stress damages chloroplasts and reduces grain yield in rice."
    },
    {
      "id": "rec:rec_78858b935a834f96996e2a9d46e4961d",
      "kind": "record",
      "type": "claim",
      "label": "How heat signals are transduced from the plasma membrane to chloroplasts remains unknown."
    },
    {
      "id": "rec:rec_79044e3e05f535856832154a51c8a87f",
      "kind": "record",
      "type": "claim",
      "label": "The objective of this study was to identify genes underlying natural variation in thermotolerance."
    },
    {
      "id": "rec:rec_eb88edbd3cdd1ce77d844d368affb702",
      "kind": "record",
      "type": "observation",
      "label": "A chromosome segment substitution line, SL14, showed higher survival than the recurrent parent WY after 12 h of heat treatment (fig. S1)."
    },
    {
      "id": "rec:rec_2f056a171ec8867c073c350da2562919",
      "kind": "record",
      "type": "method",
      "label": "We backcrossed SL14 to WY to construct a mapping population."
    },
    {
      "id": "rec:rec_3a0f62bc1262074f9c1a657e29403cd9",
      "kind": "record",
      "type": "analysis_result",
      "label": "Using 1,614 BC4F3 plants from this population, qHT3 was narrowed to a 36.6 kb interval on chromosome 3 (Table 1)."
    },
    {
      "id": "rec:rec_69945ca262a0be13812fc69f7f90fd65",
      "kind": "record",
      "type": "method",
      "label": "Only recombinant plants that survived the heat treatment were advanced to the next generation."
    },
    {
      "id": "rec:rec_4dab0ec5f5f6e600d7ec24b5bc89bf95",
      "kind": "record",
      "type": "claim",
      "label": "HTR1 underlies qHT3"
    },
    {
      "id": "rec:rec_6427ec708013a88c3bd6d089815d21ec",
      "kind": "record",
      "type": "method",
      "label": "To test whether HTR1 underlies qHT3, we generated knockout lines of HTR1 in WY by CRISPR/Cas9."
    },
    {
      "id": "rec:rec_0944532bb7d56a7c673ef0c19413b5a3",
      "kind": "record",
      "type": "observation",
      "label": "The knockout lines of HTR1 showed lower survival than WY after heat treatment (fig. S2)."
    },
    {
      "id": "rec:rec_996ddd2fb171c0a2199a4019d1970653",
      "kind": "record",
      "type": "claim",
      "label": "HTR1 might recruit HTR2 precursors to endosomes for degradation"
    },
    {
      "id": "rec:rec_2d21f963dafe36ae2335bd207c74a610",
      "kind": "record",
      "type": "observation",
      "label": "HTR1 interacted with HTR2 in a split-luciferase assay (fig. S3)."
    },
    {
      "id": "rec:rec_e4822d11955faccebf5bed73e5a40750",
      "kind": "record",
      "type": "claim",
      "label": "HTR1 acts upstream of HTR2 to protect chloroplasts under heat stress."
    },
    {
      "id": "rec:rec_477b03ee1f164c8ec52f92b6dd7a3e40",
      "kind": "record",
      "type": "claim",
      "label": "How HTR2 accumulation damages chloroplasts remains to be determined."
    },
    {
      "id": "rec:rec_4347364e90ac28cf4607e75c85f2c399",
      "kind": "record",
      "type": "method",
      "label": "Twelve-day-old seedlings were treated at 42 C for 14 h and survival was scored after 7 days of recovery."
    },
    {
      "id": "rec:rec_e9fa66c06dd335641622897f8abae636",
      "kind": "record",
      "type": "method",
      "label": "Each line was tested in 3 biological replicates of 24 plants."
    },
    {
      "id": "rec:rec_25e38f650b4ac0b365090b3d3f707721",
      "kind": "record",
      "type": "method",
      "label": "Survival rates were compared with a two-tailed t test."
    },
    {
      "id": "rec:rec_070cf8ff10ae8d8f729e6999e89b0a43",
      "kind": "record",
      "type": "method",
      "label": "Split-luciferase assays were performed in Nicotiana benthamiana leaves."
    },
    {
      "id": "rec:rec_5053cc01ca8c0044b8d3f59925e2a888",
      "kind": "record",
      "type": "phenotype_observation",
      "label": "SL14 78.5 %"
    },
